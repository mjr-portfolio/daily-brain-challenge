# Leave this unset for local dev and for Vercel production.
# Vite (local) and vercel.json (production) both proxy /api to the backend,
# so the browser stays same-origin and SameSite=Lax cookies work on Safari.
#
# Only set this if you intentionally call the Railway API from another origin:
# VITE_API_BASE=https://daily-brain-challenge.up.railway.app/api
