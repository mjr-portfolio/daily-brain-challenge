APP_NAME=project-play
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://puzzle:puzzle@localhost:5432/puzzle
JWT_SECRET=dev-only-change-me-use-32+chars!!
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30
# Local defaults. Production (Vercel page, Railway API) must set:
# APP_ENV=production
# JWT_SECRET=<long random secret>
# DATABASE_URL=<Railway Postgres URL; postgresql:// is rewritten to asyncpg>
# CORS_ORIGINS=https://your-project.vercel.app
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# GEMINI_API_KEY=<gemini key>
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Vercel build env: VITE_API_BASE=https://<web-service>.up.railway.app/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
